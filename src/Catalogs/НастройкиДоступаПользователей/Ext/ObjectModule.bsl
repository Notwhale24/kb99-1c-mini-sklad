Процедура ПередЗаписью(Отказ)
    // В наименовании указывается имя пользователя из списка пользователей ИБ.
    Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(СокрЛП(Наименование));
    Если Пользователь = Неопределено Тогда
        ВызватьИсключение "Не найден пользователь информационной базы с таким именем.";
    КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Склад) Тогда
        ВызватьИсключение "Выберите доступный пользователю склад.";
    КонецЕсли;
    ИдентификаторПользователя = Строка(Пользователь.УникальныйИдентификатор);
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Настройки.Ссылка
        |ИЗ Справочник.НастройкиДоступаПользователей КАК Настройки
        |ГДЕ Настройки.ИдентификаторПользователя = &Идентификатор
        |И Настройки.Ссылка <> &Ссылка И НЕ Настройки.ПометкаУдаления");
    Запрос.УстановитьПараметр("Идентификатор", ИдентификаторПользователя);
    Запрос.УстановитьПараметр("Ссылка", Ссылка);
    Если НЕ Запрос.Выполнить().Пустой() Тогда
        ВызватьИсключение "Для пользователя уже настроен склад. Измените существующую настройку.";
    КонецЕсли;
КонецПроцедуры
