
Функция ТоварыПолучитьТовары(Запрос)

    Товары = Новый Массив;

    Выборка = Справочники.Товары.Выбрать();
    Пока Выборка.Следующий() Цикл

        Если Выборка.ПометкаУдаления Тогда
            Продолжить;
        КонецЕсли;

        Товар = Новый Структура;
        Товар.Вставить("code", Выборка.Код);
        Товар.Вставить("name", Выборка.Наименование);

        Товары.Добавить(Товар);

    КонецЦикла;

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Товары);
    ТекстJSON = Запись.Закрыть();

    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить(
        "Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(
        ТекстJSON, КодировкаТекста.UTF8);

    Возврат Ответ;

КонецФункции

Функция ТоварыСоздатьТовар(Запрос)

    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(
            Запрос.ПолучитьТелоКакСтроку());
        Данные = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
    Исключение
        Возврат ОтветОбменаJSON(400,
            Новый Структура("error", "Некорректный JSON"));
    КонецПопытки;

    Если ТипЗнч(Данные) <> Тип("Структура") Тогда
        Возврат ОтветОбменаJSON(400,
            Новый Структура("error", "Ожидается объект JSON"));
    КонецЕсли;

    Наименование = Неопределено;

    Если НЕ Данные.Свойство("name", Наименование) Тогда
        Возврат ОтветОбменаJSON(400,
            Новый Структура("error", "Не указано поле name"));
    КонецЕсли;

    Если ТипЗнч(Наименование) <> Тип("Строка") Тогда
        Возврат ОтветОбменаJSON(400,
            Новый Структура("error", "Поле name должно быть строкой"));
    КонецЕсли;

    Наименование = СокрЛП(Наименование);

    Если ПустаяСтрока(Наименование) Тогда
        Возврат ОтветОбменаJSON(400,
            Новый Структура("error", "Наименование не должно быть пустым"));
    КонецЕсли;

    Попытка
        Товар = Справочники.Товары.СоздатьЭлемент();
        Товар.Наименование = Наименование;
        Товар.Записать();
    Исключение
        Возврат ОтветОбменаJSON(500,
            Новый Структура("error", "Не удалось записать товар"));
    КонецПопытки;

    Результат = Новый Структура;
    Результат.Вставить("code", Товар.Код);
    Результат.Вставить("name", Товар.Наименование);

    Возврат ОтветОбменаJSON(201, Результат);

КонецФункции


Функция ОтветОбменаJSON(КодСостояния, Данные)

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    ТекстJSON = Запись.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить(
        "Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(
        ТекстJSON, КодировкаТекста.UTF8);

    Возврат Ответ;

КонецФункции