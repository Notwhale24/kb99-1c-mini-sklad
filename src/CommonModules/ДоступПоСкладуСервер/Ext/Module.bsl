#Область СлужебныйПрограммныйИнтерфейс
Процедура УстановитьСкладСеанса() Экспорт
    // Закрытый серверный вызов: пользователь не может подменить склад с клиента.
    ПараметрыСеанса.ДоступныйСклад = Справочники.Склады.ПустаяСсылка();
    ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
    Если ТекущийПользователь = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Настройки.Склад КАК Склад
        |ИЗ Справочник.НастройкиДоступаПользователей КАК Настройки
        |ГДЕ Настройки.ИдентификаторПользователя = &Идентификатор
        |И НЕ Настройки.ПометкаУдаления");
    Запрос.УстановитьПараметр("Идентификатор", Строка(ТекущийПользователь.УникальныйИдентификатор));
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        ПараметрыСеанса.ДоступныйСклад = Выборка.Склад;
    КонецЕсли;
КонецПроцедуры
#КонецОбласти
