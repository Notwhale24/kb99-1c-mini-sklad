#Область ПрограммныйИнтерфейс
Процедура ОбновитьСостояниеСкладов() Экспорт
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Блокировка.Добавить("Справочник.СостояниеСкладов");
        Блокировка.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ Склады.Ссылка КАК Склад,
            |ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоТоваров
            |ИЗ Справочник.Склады КАК Склады
            |ЛЕВОЕ СОЕДИНЕНИЕ
            |(ВЫБРАТЬ Остатки.Склад КАК Склад,
            |СУММА(Остатки.КоличествоОстаток) КАК КоличествоОстаток
            |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки() КАК Остатки
            |СГРУППИРОВАТЬ ПО Остатки.Склад) КАК Остатки
            |ПО Склады.Ссылка = Остатки.Склад
            |ГДЕ НЕ Склады.ПометкаУдаления");
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Ссылка = Справочники.СостояниеСкладов.НайтиПоРеквизиту("Склад", Выборка.Склад);
            Если Ссылка.Пустая() Тогда
                Элемент = Справочники.СостояниеСкладов.СоздатьЭлемент();
            Иначе
                Элемент = Ссылка.ПолучитьОбъект();
            КонецЕсли;
            Элемент.Склад = Выборка.Склад;
            Элемент.Наименование = Строка(Выборка.Склад);
            Элемент.КоличествоТоваров = Выборка.КоличествоТоваров;
            Элемент.Обновлено = ТекущаяДатаСеанса();
            Элемент.Записать();
        КонецЦикла;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ЗаписьЖурналаРегистрации("МиниСклад.ОбновлениеСостоянияСкладов", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
#КонецОбласти
