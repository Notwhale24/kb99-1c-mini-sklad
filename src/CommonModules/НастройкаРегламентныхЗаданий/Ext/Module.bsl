Процедура ИнициализироватьРасписание() Экспорт
    Если НЕ РольДоступна("Администратор") Тогда
        Возврат;
    КонецЕсли;
    Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания() Цикл
        Если Задание.Метаданные <> Метаданные.РегламентныеЗадания.ОбновлениеСостоянияСкладов Тогда
            Продолжить;
        КонецЕсли;
        // После первой настройки пользовательское расписание не изменяем.
        Если Задание.Ключ <> "СостояниеСкладов" Тогда
            Продолжить;
        КонецЕсли;
        Расписание = Новый РасписаниеРегламентногоЗадания;
        Расписание.ПериодПовтораДней = 1;
        Расписание.ПериодПовтораВТечениеДня = 3600;
        Задание.Расписание = Расписание;
        Задание.ИмяПользователя = ИмяПользователя();
        Задание.Использование = Истина;
        Задание.Ключ = "СостояниеСкладов.Настроено";
        Задание.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура ОбновитьСейчас() Экспорт
    Если НЕ РольДоступна("Администратор") Тогда
        ВызватьИсключение "Обновление доступно только администратору.";
    КонецЕсли;
    ОбновлениеСлужебныхДанных.ОбновитьСостояниеСкладов();
КонецПроцедуры
