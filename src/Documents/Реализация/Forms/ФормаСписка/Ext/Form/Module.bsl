#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    ПравилоОформления = Список.КомпоновщикНастроек.Настройки.УсловноеОформление.Элементы.Добавить();
    ПравилоОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 245, 213));
    ПравилоОформления.Представление = "Непроведённые документы";

    Условие = ПравилоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проведен");
    Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
    Условие.ПравоеЗначение = Ложь;
    Условие.Использование = Истина;

КонецПроцедуры

#КонецОбласти
