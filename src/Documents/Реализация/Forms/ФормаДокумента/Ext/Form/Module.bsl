#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПересчитатьСумму(Элемент)
	Перем ТекущаяСтрокаТоваров;
	ТекущаяСтрокаТоваров = Элементы.Товары.ТекущиеДанные;
	Если ТекущаяСтрокаТоваров <> Неопределено Тогда
		ТекущаяСтрокаТоваров.Сумма = ТекущаяСтрокаТоваров.Количество * ТекущаяСтрокаТоваров.Цена;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьТовары(Команда)

    Оповещение = Новый ОписаниеОповещения("ПослеПодбораТоваров", ЭтотОбъект);
    ОткрытьФорму("Справочник.Товары.Форма.ПодборТоваров", , ЭтотОбъект, , , , Оповещение,
        РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ПослеПодбораТоваров(ВыбранныеТовары, ДополнительныеПараметры) Экспорт

    Если ВыбранныеТовары = Неопределено Тогда
        Возврат;
    КонецЕсли;

    Для Каждого Товар Из ВыбранныеТовары Цикл
        ДобавитьПодобранныйТовар(Товар);
    КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьПодобранныйТовар(Товар)

    Если ТипЗнч(Товар) <> Тип("СправочникСсылка.Товары") Или Не ЗначениеЗаполнено(Товар) Тогда
        Возврат;
    КонецЕсли;

    // При нескольких ценах оставляем отдельную строку для новой позиции.
    СтрокиТовара = Объект.Товары.НайтиСтроки(Новый Структура("Товар", Товар));
    Если СтрокиТовара.Количество() = 1 Тогда
        СтрокаТоваров = СтрокиТовара[0];
        СтрокаТоваров.Количество = СтрокаТоваров.Количество + 1;
    Иначе
        СтрокаТоваров = Объект.Товары.Добавить();
        СтрокаТоваров.Товар = Товар;
        СтрокаТоваров.Количество = 1;
    КонецЕсли;
    СтрокаТоваров.Сумма = СтрокаТоваров.Количество * СтрокаТоваров.Цена;

КонецПроцедуры

#КонецОбласти
