#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	// Блокируем остатки склада до чтения и изменения
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить(
	"РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Склад", Склад);
	Блокировка.Заблокировать();

	// Возвращаем в расчёт только прежний расход, попавший в остатки до новой даты.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.Товар КАК Товар,
	|	Данные.Партия КАК Партия,
	|	СУММА(Данные.Количество) КАК КоличествоОстаток,
	|	СУММА(Данные.Сумма) КАК СуммаОстаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.Товар КАК Товар,
	|		Остатки.Партия КАК Партия,
	|		Остатки.КоличествоОстаток КАК Количество,
	|		Остатки.СуммаОстаток КАК Сумма
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваров.Остатки(
	|			&Момент, Склад = &Склад И Товар В (&Товары)) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ПрежнийРасход.Товар,
	|		ПрежнийРасход.Партия,
	|		ПрежнийРасход.Количество,
	|		ПрежнийРасход.Сумма
	|	ИЗ
	|		РегистрНакопления.ОстаткиТоваров КАК ПрежнийРасход
	|	ГДЕ
	|		ПрежнийРасход.Регистратор = &Регистратор
	|		И ПрежнийРасход.Период < &ДатаДокумента
	|		И ПрежнийРасход.Склад = &Склад
	|		И ПрежнийРасход.Товар В (&Товары)
	|		И ПрежнийРасход.Активность
	|		И ПрежнийРасход.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)) КАК Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.Товар,
	|	Данные.Партия
	|
	|ИМЕЮЩИЕ
	|	СУММА(Данные.Количество) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Данные.Партия.Дата,
	|	Партия";

	Запрос.УстановитьПараметр("Момент",
	Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Запрос.УстановитьПараметр("ДатаДокумента", Дата);
	Запрос.УстановитьПараметр("Товары",
	Товары.Выгрузить().ВыгрузитьКолонку("Товар"));

	ОстаткиПартий = Запрос.Выполнить().Выгрузить();
	ОстаткиПоТоварам = Новый Соответствие;
	Для Каждого ОстатокПартии Из ОстаткиПартий Цикл
		ПартииТовара = ОстаткиПоТоварам.Получить(ОстатокПартии.Товар);
		Если ПартииТовара = Неопределено Тогда
			ПартииТовара = Новый Массив;
			ОстаткиПоТоварам.Вставить(ОстатокПартии.Товар, ПартииТовара);
		КонецЕсли;
		ПартииТовара.Добавить(ОстатокПартии);
	КонецЦикла;

	СписанияПартий = Новый Массив;
	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл

		Если ТекущаяСтрокаТоваров.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Количество товара должно быть больше нуля.";
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;

		ПартииТовара = ОстаткиПоТоварам.Получить(ТекущаяСтрокаТоваров.Товар);
		ОсталосьСписать = СписатьПоПартиям(
		ТекущаяСтрокаТоваров.Товар, ТекущаяСтрокаТоваров.Количество,
		ПартииТовара, СписанияПартий);

		Если ОсталосьСписать > 0 Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
			"На складе «%1» недостаточно товара «%2». Не хватает: %3.",
			Склад, ТекущаяСтрокаТоваров.Товар, ОсталосьСписать);
			Сообщение.Сообщить();
			Возврат;
		КонецЕсли;

	КонецЦикла;

	// Формируем движения только после проверки всех строк.
	Движения.ОстаткиТоваров.Очистить();
	Движения.ОборотыПродажТоваров.Очистить();

	Для Каждого Списание Из СписанияПартий Цикл
		ДвижениеРегистра = Движения.ОстаткиТоваров.Добавить();
		ДвижениеРегистра.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеРегистра.Период = Дата;
		ДвижениеРегистра.Товар = Списание.Товар;
		ДвижениеРегистра.Склад = Склад;
		ДвижениеРегистра.Партия = Списание.Партия;
		ДвижениеРегистра.Количество = Списание.Количество;
		ДвижениеРегистра.Сумма = Списание.Сумма;
	КонецЦикла;

	Для Каждого ТекущаяСтрокаТоваров Из Товары Цикл
		// В обороты записываем выручку по цене продажи
		ДвижениеРегистра = Движения.ОборотыПродажТоваров.Добавить();
		ДвижениеРегистра.Период = Дата;
		ДвижениеРегистра.Товар = ТекущаяСтрокаТоваров.Товар;
		ДвижениеРегистра.Склад = Склад;
		ДвижениеРегистра.Количество = ТекущаяСтрокаТоваров.Количество;
		ДвижениеРегистра.Сумма = Окр(
		ТекущаяСтрокаТоваров.Количество * ТекущаяСтрокаТоваров.Цена, 2);

	КонецЦикла;

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ОборотыПродажТоваров.Записывать = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СписатьПоПартиям(ТоварСтроки, КоличествоСтроки, ПартииТовара, СписанияПартий)

	ОсталосьСписать = КоличествоСтроки;

	Если ПартииТовара = Неопределено Тогда
		Возврат ОсталосьСписать;
	КонецЕсли;

	Для Каждого ОстатокПартии Из ПартииТовара Цикл

		Если ОстатокПартии.КоличествоОстаток <= 0 Тогда
			Продолжить;
		КонецЕсли;

		КоличествоКСписанию = Мин(
		ОсталосьСписать,
		ОстатокПартии.КоличествоОстаток);

		Если КоличествоКСписанию = ОстатокПартии.КоличествоОстаток Тогда
			СуммаСписания = ОстатокПартии.СуммаОстаток;
		Иначе
			СуммаСписания = Окр(
			ОстатокПартии.СуммаОстаток
			/ ОстатокПартии.КоличествоОстаток
			* КоличествоКСписанию, 2);
		КонецЕсли;

		СписанияПартий.Добавить(Новый Структура(
		"Товар, Партия, Количество, Сумма",
		ТоварСтроки, ОстатокПартии.Партия, КоличествоКСписанию, СуммаСписания));

		ОсталосьСписать = ОсталосьСписать - КоличествоКСписанию;

		// Учитываем расход для следующих строк того же товара
		ОстатокПартии.КоличествоОстаток =
		ОстатокПартии.КоличествоОстаток - КоличествоКСписанию;
		ОстатокПартии.СуммаОстаток =
		ОстатокПартии.СуммаОстаток - СуммаСписания;

		Если ОсталосьСписать = 0 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат ОсталосьСписать;

КонецФункции

#КонецОбласти
