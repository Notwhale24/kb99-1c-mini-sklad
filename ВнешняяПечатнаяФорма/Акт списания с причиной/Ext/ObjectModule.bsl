Функция СведенияОВнешнейОбработке() Экспорт
    Сведения = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке();
    Сведения.Вид = "ПечатнаяФорма";
    Сведения.Версия = "1.0";
    Сведения.Наименование = "Акт о списании товаров (с причиной)";
    Сведения.Информация = "Стандартный акт списания с причиной из дополнительного реквизита или комментария документа.";
    Сведения.Назначение.Добавить("Документ.СписаниеНедостачТоваров");
    Команда = Сведения.Команды.Добавить();
    Команда.Идентификатор = "АктСписанияСПричиной";
    Команда.Представление = Сведения.Наименование;
    Команда.Использование = "ВызовСерверногоМетода";
    Команда.Модификатор = "ПечатьMXL";
    Возврат Сведения;
КонецФункции

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
    Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "АктСписанияСПричиной") Тогда
        УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
            КоллекцияПечатныхФорм, "АктСписанияСПричиной", "Акт о списании товаров (с причиной)",
            СформироватьАкт(МассивОбъектов, ОбъектыПечати));
    КонецЕсли;
КонецПроцедуры

Функция СформироватьАкт(ДокументыДляПечати, ОбъектыПечати = Неопределено) Экспорт
    Результат = Новый ТабличныйДокумент;
    Результат.АвтоМасштаб = Истина;
    Результат.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АктСписанияСПричиной";
    Если ОбъектыПечати = Неопределено Тогда
        ОбъектыПечати = Новый СписокЗначений;
    КонецЕсли;
    Для Каждого СсылкаДокумента Из ДокументыДляПечати Цикл
        Если ТипЗнч(СсылкаДокумента) <> Тип("ДокументСсылка.СписаниеНедостачТоваров") Тогда
            ВызватьИсключение "Печатная форма предназначена для документа «Списание недостач товаров».";
        КонецЕсли;
        Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
            ВызватьИсключение "Сначала запишите документ списания.";
        КонецЕсли;
        Документ = СсылкаДокумента.ПолучитьОбъект();
        Причина = ПолучитьПричинуСписания(Документ);
        ОдинДокумент = Новый Массив;
        ОдинДокумент.Добавить(СсылкаДокумента);
        Коллекция = УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм("АктСписанияТоваров");
        ЛокальныеОбъектыПечати = Новый СписокЗначений;
        ПараметрыВывода = УправлениеПечатью.ПодготовитьСтруктуруПараметровВывода();
        // Штатный макет сохраняет штрихкод, единицы, подписи и настройки конфигурации.
        Документы.СписаниеНедостачТоваров.Печать(ОдинДокумент, Новый Структура,
            Коллекция, ЛокальныеОбъектыПечати, ПараметрыВывода);
        Акт = Коллекция[0].ТабличныйДокумент;
        СтрокаПричины = Акт.ВысотаТаблицы + 2;
        Область = Акт.Область(СтрокаПричины, 1, СтрокаПричины, Акт.ШиринаТаблицы);
        Область.Объединить();
        Область.Текст = "Причина списания: " + Причина;
        Область.Шрифт = Новый Шрифт("Arial", 10, Истина);
        Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
        Если Результат.ВысотаТаблицы > 0 Тогда
            Результат.ВывестиГоризонтальныйРазделительСтраниц();
        КонецЕсли;
        НачальнаяСтрока = Результат.ВысотаТаблицы + 1;
        Результат.Вывести(Акт);
        УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
            Результат, НачальнаяСтрока, ОбъектыПечати, СсылкаДокумента);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПолучитьПричинуСписания(Документ) Экспорт
    Если Документ.Метаданные().Реквизиты.Найти("ПричинаСписания") <> Неопределено Тогда
        Причина = СокрЛП(Строка(Документ.ПричинаСписания));
        Если Не ПустаяСтрока(Причина) Тогда
            Возврат Причина;
        КонецЕсли;
    КонецЕсли;
    Для Каждого Реквизит Из Документ.ДополнительныеРеквизиты Цикл
        Если НРег(СокрЛП(Реквизит.Свойство.Наименование)) = "причина списания" Тогда
            Причина = СокрЛП(Реквизит.ТекстоваяСтрока);
            Если ПустаяСтрока(Причина) Тогда
                Причина = СокрЛП(Строка(Реквизит.Значение));
            КонецЕсли;
            Если Не ПустаяСтрока(Причина) Тогда
                Возврат Причина;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Причина = СокрЛП(Документ.Комментарий);
    Возврат ?(ПустаяСтрока(Причина), "Не указана", Причина);
КонецФункции
